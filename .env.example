# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/agriSmart_db

# AI Model Configuration
MODEL_CHECKPOINT_PATH=model/checkpoints/E11_SigLIP_HYBRID10_PRODUCTION.pt
MODEL_VERSION=E11-SigLIP-HYBRID10-PRODUCTION

# Environment
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq AI
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Copernicus Data Space
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STATISTICAL_URL=https://sh.dataspace.eu/api/v1/statistical
COPERNICUS_PROCESS_URL=https://sh.dataspace.eu/api/v1/process
SATELLITE_REQUEST_TIMEOUT_SECONDS=30
